# Browser engine: persistent Chrome user_data_dir (22MB+ runtime artifacts,
# machine-specific cache, never share across machines)
backend/data/browser_profiles/

# Browser engine: session secrets (cookies + JWT tokens). Each developer/server
# must run their own login script and produce their own session file. Never
# commit — anyone with the file can sign in as that account.
backend/data/browser_sessions/*.json
backend/data/browser_sessions/*_profile.json

play_snapshot.sh

# Browser engine session secrets + Chrome profiles — ANY location (含 services/),
# 含 cookies/JWT/原始 Cookies 库。已 git rm --cached;永不提交(谁拿到谁能登录该账号)。
**/data/browser_sessions/
**/data/browser_profiles/
