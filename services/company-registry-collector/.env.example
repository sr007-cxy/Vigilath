# ---- Login sessions for each provider (fill in the full Cookie header for the provider you need) ----
# Qichamao: key items qz.newsite / qznewsite.uid; qz.newsite expires
QICHAMAO_COOKIE=
# Providers added later each use their own environment variable, for example:
# TIANYANCHA_COOKIE=
# QCC_COOKIE=

# ---- Common collection parameters ----
ENTDATA_INTERVAL=0.8      # request interval in seconds
ENTDATA_TIMEOUT=25        # request timeout in seconds
ENTDATA_MAX_DETAIL=500    # hard cap on detail enrichment
# ENTDATA_UA=            # custom UA

# ---- FastAPI access token (if set, requests must carry the X-ENTDATA-Token header) ----
ENTDATA_TOKEN=
