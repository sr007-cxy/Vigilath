# Backend environment variables — copy this file to `.env` and fill in real
# values. DO NOT commit `.env` (it is in .gitignore).

# ==================== Transactional email (Resend) ====================
# Production uses Resend, not SMTP. SMTP_* keys below are legacy/unused.
RESEND_API_KEY=
FROM_EMAIL=GEO Checker <support@zen7.com>
FRONTEND_URL=https://www.vigilath.com
# Inbox receiving /contact + /contact-sales submission notifications
SALES_NOTIFY_EMAIL=support@zen7.com

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDER_EMAIL=

# ==================== OAuth providers ====================
GOOGLE_CLIENT_ID=

# ==================== Stripe Payment ====================
# Get keys from https://dashboard.stripe.com/apikeys
# Use sk_test_... / pk_test_... in development, sk_live_... / pk_live_... in production.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Stripe Webhook signing secret (whsec_...). Optional for dev — without it the
# checkout success page polls /api/payment/stripe/session/{id} as a safety net.
STRIPE_WEBHOOK_SECRET=
# Set to "true" only if you have explicitly wired a test-mode bypass in code.
STRIPE_TEST_MODE=false
# Where Stripe sends the user back after checkout. Must be reachable on the
# public domain — localhost will not work in production.
STRIPE_SUCCESS_URL=https://www.vigilath.com/checkout/success
STRIPE_CANCEL_URL=https://www.vigilath.com/checkout/cancel

# ==================== WeChat Pay (微信支付) ====================
# 微信商户平台 https://pay.weixin.qq.com 获取凭证
WECHAT_PAY_ENABLED=false
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_KEY_V3=
WECHAT_PAY_CERT_SERIAL=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_NOTIFY_URL=https://www.vigilath.com/api/payment/wechat/notify

 # AI 引擎 Key(付费检测模式)
OPENROUTER_API_KEY=
# ==================== JWT ====================
# Generate with: openssl rand -hex 32
SECRET_KEY=

# ==================== AI engine keys (paid detection modes) ====================
# At least one is required for --ai-visibility / --citation-check / --entity flows.
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
ANTHROPIC_API_KEY=
