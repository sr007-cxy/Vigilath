# Backend environment variables — copy this file to `.env` and fill in real
# values. DO NOT commit `.env` (it is in .gitignore).

# ==================== Site region (Region) ====================
# Same codebase; each of the two servers sets its own .env to distinguish CN site / global site. Regional differences (which
# engines/payments/compliance/default language are enabled) all converge under this switch, no long-lived branches.
#   global = global site (ChatGPT/Perplexity/Claude, Stripe, English default)
#   cn     = CN site (deepseek/qwen/Wenxin/Yuanbao/doubao, WeChat Pay, Chinese default)
REGION=global

# ==================== Agency permission workspace ====================
# Off by default. Enable in a canary environment only after DB migrations, P6 health checks and internal acceptance all pass.
# Disabling hides the org management API and frontend entry; it does not delete orgs, grants, contexts or audit data.
AGENCY_WORKBENCH_ENABLED=false

# ==================== Transactional email (Resend) ====================
# Production uses Resend, not SMTP. SMTP_* keys below are legacy/unused.
RESEND_API_KEY=
FROM_EMAIL=
FRONTEND_URL=https://www.vigilath.com
# Inbox receiving /contact + /contact-sales submission notifications
SALES_NOTIFY_EMAIL=
# Support phone shown in the Feishu / WeCom ISV welcome card; leave empty to hide it.
SUPPORT_PHONE=
# Help-doc link shown in the Feishu / WeCom ISV welcome card.
HELP_DOC_URL=

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDER_EMAIL=

# ==================== OAuth providers ====================
GOOGLE_CLIENT_ID=

# ==================== Stripe Payment ====================
# Get keys from https://dashboard.stripe.com/apikeys
# Use sk_test_... / pk_test_... in development, sk_live_... / pk_live_... in production.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Stripe Webhook signing secret (whsec_...). Optional for dev — without it the
# checkout success page polls /api/payment/stripe/session/{id} as a safety net.
STRIPE_WEBHOOK_SECRET=
# Set to "true" only if you have explicitly wired a test-mode bypass in code.
STRIPE_TEST_MODE=false
# Where Stripe sends the user back after checkout. Must be reachable on the
# public domain — localhost will not work in production.
STRIPE_SUCCESS_URL=https://www.vigilath.com/checkout/success
STRIPE_CANCEL_URL=https://www.vigilath.com/checkout/cancel

# ==================== WeChat Pay ====================
# Get credentials from the WeChat merchant platform https://pay.weixin.qq.com
WECHAT_PAY_ENABLED=false
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_KEY_V3=
WECHAT_PAY_CERT_SERIAL=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_NOTIFY_URL=https://www.vigilath.com/api/payment/wechat/notify

# ── WeChat Official Account QR-code login ──────────────────────────────────
# Prerequisite: a **verified service account** (subscription accounts lack the parametric temporary QR API, returns 48001).
# Three things to configure on the Official Accounts Platform:
#   1. Settings & Development > Basic Configuration > Server Configuration
#        URL   = https://<site-domain>/api/auth/wechat/callback
#        Token = WECHAT_MP_TOKEN below; choose "plaintext mode" for message encryption
#        (if you choose secure mode, put the EncodingAESKey into WECHAT_MP_AES_KEY;
#         in secure mode the backend only returns an empty ack, no welcome message)
#   2. Basic Configuration > IP whitelist: add the server egress IP, otherwise exchanging access_token returns 40164
#   3. Put the AppSecret into WECHAT_MP_APP_SECRET (shared with JSAPI payment)
WECHAT_LOGIN_ENABLED=false
#   4. The login account and payment account are often different: fill AppID / AppSecret separately;
#      mixing them exchanges account B's token with account A's secret, and WeChat returns 40001
WECHAT_MP_APP_ID=            # Login official account AppID; falls back to WECHAT_PAY_APP_ID only when empty
WECHAT_LOGIN_APP_SECRET=     # Login official account AppSecret; falls back to WECHAT_MP_APP_SECRET only when empty
WECHAT_MP_TOKEN=
WECHAT_MP_AES_KEY=           # Leave empty in plaintext mode
WECHAT_QR_EXPIRE_SECONDS=300

# ── SMS verification code channel (bind phone number / phone login) ──────────
# SMS_PROVIDER=aliyun (default) | tencent (legacy channel, kept for switching back)
SMS_PROVIDER=aliyun
SMS_SIGN_NAME=               # Registered signature, e.g. <your registered SMS signature>
SMS_TEMPLATE_ID=             # Aliyun SMS_<template-id>; Tencent Cloud uses a pure number
SMS_INTL_SIGN_NAME=          # Signature for international/HK/Macau/Taiwan numbers (registered separately); empty falls back to SMS_SIGN_NAME
SMS_INTL_TEMPLATE_ID=        # Template for international/HK/Macau/Taiwan numbers; empty falls back to SMS_TEMPLATE_ID
# Aliyun AK: a dedicated SMS key pair (sub-account granted only AliyunDysmsFullAccess); empty falls back to the compliance-check
# ALIBABA_CLOUD_ACCESS_KEY_ID/SECRET (that pair needs SMS permission granted separately)
SMS_ALIYUN_ACCESS_KEY_ID=
SMS_ALIYUN_ACCESS_KEY_SECRET=
# Aliyun template variable names, in order [code, valid minutes]. The console's default code template only has ${code};
# if the template also contains ${min} minutes, set code,min
SMS_TEMPLATE_PARAM_NAMES=code
# Tencent Cloud (only used when SMS_PROVIDER=tencent). Template param positions are fixed {1}=code {2}=valid minutes, e.g.:
#   您的验证码为{1}，{2}分钟内有效，请勿泄露。 ("Your code is {1}, valid for {2} minutes; do not share it.")
# Note: sms.tencentcloudapi.com is a CN API; for CN deployments add
#       .tencentcloudapi.com to geo-backend's NO_PROXY.
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
SMS_APP_ID=                  # SdkAppId, starts with 1400
SMS_CODE_TTL_SECONDS=300
SMS_RESEND_INTERVAL_SECONDS=60
SMS_DEBUG_ECHO=false         # true = only log the code without sending; local integration testing only

# Master gate for email signup. false = public signup only via WeChat QR; email **login** is unaffected,
# workspace admins calling /api/auth/register with an admin token can still create accounts on behalf of customers.
EMAIL_REGISTER_ENABLED=false

 # AI engine keys (paid audit mode)
OPENROUTER_API_KEY=
# ==================== JWT ====================
# Generate with: openssl rand -hex 32
SECRET_KEY=

# ==================== AI engine keys (paid detection modes) ====================
# At least one is required for --ai-visibility / --citation-check / --entity flows.
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
ANTHROPIC_API_KEY=

# ==================== Mediumsly internal publish API ====================
# When admin approves a doc with push_to_mediumsly=true, GEO posts to Mediumsly
# via its internal API and the doc gets a published URL on mediumsly.com.
# Empty token = publisher disabled (publish flow still works, just skips push).
# See docs/05-geo-integration.md in the mediumsly repo.
MEDIUMSLY_API_URL=
MEDIUMSLY_INTERNAL_API_TOKEN=
# Comma-separated email domains allowed to be published *as* via this integration.
# Hard guardrail against accidentally impersonating real users on Mediumsly.
# Leave empty = no allowlist (NOT recommended for prod).
MEDIUMSLY_EMAIL_DOMAIN_ALLOWLIST=

# ==================== Meijiexing agency publishing API ====================
# docs/04-开发实现/内容与发布/媒体API/产品文档-媒介星发文对接.md. Empty secret = channel not enabled.
# MJX_PUBLISH_ENABLED is a separate gate for real (paid) orders; query endpoints are unrestricted.
MJX_API_BASE=
MJX_SECRET_ID=
MJX_SECRET_KEY=
MJX_PUBLISH_ENABLED=0

# ==================== Ruanwenjiang paid press-release channel ====================
# docs/04-开发实现/研发计划/M2-软文匠通道接入计划.md + 发文对接.md. Empty credentials = channel not enabled.
# RWJ_PUBLISH_ENABLED is off by default: only pushing drafts (free) is allowed; real orders (charged) require opening the gate explicitly.
# Note: tenant.meijieku.com is a CN API; for CN deployments add it to NO_PROXY.
RWJ_API_BASE=
RWJ_MOBILE=
RWJ_PASSWORD=
RWJ_TOKEN_PATH=data/rwj_tokens.json
RWJ_PUBLISH_ENABLED=0

# ==================== Meijieku (upstream site of the same vendor) ====================
# vip.meijieku.com / api.meijieku.com — Ruanwenjiang's API domain is tenant.meijieku.com;
# both share the same protocol and resource pool, but quotes depend on each site's membership tier, so mirror both to compare prices.
# **The charge gate reuses RWJ_PUBLISH_ENABLED above**; no separate switch.
# Note: api.meijieku.com is also a CN API; for CN deployments add it to NO_PROXY.
MJK_API_BASE=
MJK_MOBILE=
MJK_PASSWORD=
MJK_TOKEN_PATH=data/mjk_tokens.json
MJK_SYNC_TOKEN_PATH=data/mjk_tokens_sync.json
# Which sites the resource mirror sync covers (comma-separated); sites without credentials are skipped
RWJ_SYNC_PROVIDERS=rwj,mjk

# ==================== aitoearn multi-platform distribution channel ====================
# Publish via own authorized accounts (WeChat OA/Xiaohongshu/Douyin image posts, etc.), free, no charge gate. Empty key = not enabled.
# Create the key at https://aitoearn.cn Settings -> API key; authorize social accounts in the aitoearn dashboard.
# Note: aitoearn.cn is a CN API; for CN deployments add it to NO_PROXY.
AITOEARN_API_BASE=
AITOEARN_API_KEY=

# ==================== Self-hosted account pool publishing channel (server_pool) ====================
# docs/03-系统设计/多平台多账号分发-开发设计方案.md. Our own browser-automation publishing,
# covering platforms Aitoearn doesn't support and that have no official publish API (Zhihu/Toutiao/Baijiahao/Sohu/...).
#
# 🔴 PUBLISH_CRED_KEY: encryption key for publishing login sessions (cookies). **Must be set**, otherwise the register endpoint
#    returns 503 outright — a leaked engine cookie only allows queries, a leaked publish cookie allows impersonated publishing,
#    so this is a hard failure rather than a silent downgrade like ENGINE_CRED_KEY.
#    Deliberately separate from ENGINE_CRED_KEY (different blast radius). Generate: openssl rand -base64 48
#    ⚠️ Changing this key turns every login session persisted to DB into undecryptable garbage; all accounts must be re-imported.
PUBLISH_CRED_KEY=
# Service token for worker task claim / receipts. Empty = all worker endpoints return 503 (they hand out plaintext
# login sessions; closed is safer than open when unconfigured). The same-named var on browser-service guards the /publish write endpoints.
PUBLISH_SERVICE_TOKEN=
# Public probing of candidate publish URLs is on by default; set to 0 to disable in an emergency on platform anti-bot or false positives.
GEO_PUBLISH_URL_RECONCILE_ENABLED=1
# Ctrip plugin verification: production first check at 1 hour, then observe for another 24 hours after first launch.
# For integration testing, both can be temporarily set to 300.
CTRIP_VERIFY_INITIAL_DELAY_SECONDS=3600
CTRIP_VERIFY_CONFIRM_DELAY_SECONDS=86400
# Address the backend uses to call the publish machine's browser-service, for publish account login, identity checks, keep-alive and reconciliation.
# Production recommendation: use the publish machine's private IP on 8092, not a public domain.
BROWSER_SERVICE_AUTHORIZE_URL=http://<publish-worker-internal-ip>:8092
# browser-service manual security verification sessions. The account center opens noVNC/remote browser via this address;
# it must be protected by an authenticated reverse proxy; never expose the raw VNC port to the internet.
# These three variables are set in the browser-service process environment.
PUBLISH_MANUAL_TAKEOVER_URL=
# Set to 1 to open an interactive window on the publish machine desktop; requires Xvfb + VNC/noVNC first.
PUBLISH_MANUAL_LOGIN_HEADED=0
PUBLISH_MANUAL_LOGIN_TTL_SEC=600
PUBLISH_MANUAL_LOGIN_MAX_SESSIONS=3
# Per-account daily publish cap (0 = unlimited). The account pool is unlimited by default; override per platform for risk control.
# For example: PUBLISH_DAILY_CAP_ZHIHU=2
# PUBLISH_DAILY_CAP_ZHIHU=
# Warm-up is decided by the "enable warm-up period" toggle when adding an account; once enabled it lasts 7 days.
# Daily cap during the warm-up period (the manual -> automated behavior transition).
PUBLISH_WARMUP_DAILY_CAP=0
# Minimum interval between two publishes from one account (seconds). Default 1 minute. ⚠️ This is only a lower bound — fixed intervals are
# themselves a bot signature; real scheduling jitter is in development step 9.
PUBLISH_MIN_GAP_SEC=60
# Days to extend expires_at after a successful publish. 🔴 Counted from the last **successful use**, not from collection
# (a hard TTL expiry kills good accounts, see docs/06-发布运维/运维/排障-账号池误判与TTL死锁.md).
PUBLISH_RENEW_TTL_DAYS=14
# Account lease duration (minutes). Used to auto-release when a worker process is killed.
PUBLISH_LEASE_TTL_MINUTES=30
# Termination time for a claimed task with no receipt; the sweeper releases expired leases but never re-dispatches tasks with unknown outcome.
PUBLISH_CLAIM_STALE_MINUTES=30
# Seconds to defer a task when no account is available (attempt is not incremented, does not consume retry budget).
PUBLISH_TRANSIENT_BACKOFF_SEC=90
# 🔴 Conservative wait (seconds) for submit_unknown (request may have reached the platform but the response timed out).
# ≥600 — never blindly retry; after waiting this long, reconcile via draft_id.
PUBLISH_SUBMIT_UNKNOWN_DEFER_SEC=600
# Rate-limit cooldown: how long the offending account cools down / how long sibling accounts on the same egress IP cool down (0 = off).
# 🔴 Rate limits are judged per IP, not per account; cooling only the offending account feeds same-IP accounts
# into the wall one by one (engine pool observation: same-IP accounts all died within the same minute).
PUBLISH_RATE_LIMIT_COOLDOWN_SEC=21600
PUBLISH_SIBLING_COOLDOWN_SEC=14400

# ── Shared media storage (2026-09-16) ───────────────────────────────────────
# The test site and production share appdb but each has its own local disk — images uploaded on one side are missing on the other.
# Set to s3 and the local disk becomes a cache; files are stored in MinIO.
# The bucket need not be public: externally it is still served via /api/ai-telemetry/public/topic-media/.
# Backfill existing files: python scripts/media_sync_to_s3.py (run once on each machine, idempotent)
GEO_MEDIA_BACKEND=local            # local | s3
GEO_S3_ENDPOINT=
GEO_S3_BUCKET=
GEO_S3_ACCESS_KEY=
GEO_S3_SECRET_KEY=
# GEO_S3_PREFIX=topic_media        # Object key prefix, default topic_media
# GEO_S3_REGION=us-east-1          # Anything works for MinIO; keep the default

# ── Batch run center (V-networks worker-center) ───────────────────────
# Address: compose defaults to https://<worker-center-host>; for local dev point to a locally started worker-center
# TELEMETRY_SERVICE_URL=http://localhost:8095
# Key for the seven business endpoints (/run-now /enqueue /run-topic /cell-insight /briefing/generate ...),
# same value as INTERNAL_TOKEN in worker-center .env; if unset no header is sent (open when unset on the center side)
INTERNAL_TOKEN=
