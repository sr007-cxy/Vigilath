# systemd unit: standalone service for the GEO optimization Agent (option B).
# Install: cp to /etc/systemd/system/geo-agent.service && systemctl daemon-reload && systemctl enable --now geo-agent
# Adjust fields to match the actual geo-backend.service (User/EnvironmentFile paths).
[Unit]
Description=Vigilath GEO Agent Service (Pydantic AI + DeepSeek)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/geo/backend
EnvironmentFile=/opt/geo/backend/.env
# Dedicated venv (pydantic>=2.11 + pydantic-ai), isolated from the main backend
ExecStart=/opt/geo/agent-venv/bin/uvicorn agents.geo.service:app --host 127.0.0.1 --port 8010
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
