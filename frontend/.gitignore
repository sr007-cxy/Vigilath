*.sln
*.sw?

# Output of the UI spec preview page (source in frontend/.uikit-preview/, output not committed)
.uikit-dist/

# Distribution output of the publish plugin -- generated by `pnpm pack:web` from the extension build output, not committed
/public/downloads/plugin/*.zip
/public/downloads/plugin/*.crx

# Same as above: version.json's downloadUrl points to /plugin, and the zip is copied here for in-site download,
# also build output. Without this rule, `git add -A` would commit it along with the build output.
/public/plugin/*.zip
/public/plugin/*.crx
