# Frontend environment variables — copy this file to `.env` and adjust as needed.
# DO NOT commit `.env` (it is in .gitignore).
#
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
# Anything else is a build-time hint for tooling.

NODE_ENV=development

# ==================== Site region (Region) ====================
# Decided 2026-09-18: **leave empty, don't set to cn**. After the ICP filing remediation this repo only builds the CN site; plan prices
# in RMB are determined by the **backend** REGION=cn (backend/.env), the frontend isn't involved. The only remaining effect
# of this frontend variable is in ProductsServices.tsx: setting it to cn switches the product page to a "service catalog" that hides prices,
# the opposite of the production policy (prices shown).
# Note: Docker builds can't read this file (.dockerignore excludes .env); VITE_* only take effect when
# passed via --build-arg in the deploy script.
VITE_REGION=
# ICP filing number (CN site only, e.g. "沪ICP备12345678号-1"). Empty = use the default filing number in code.
VITE_ICP_BEIAN=
# Value-added telecom business license (EDI license number). The "Special Provisions" require it
# to be shown prominently on the home page. Format e.g. "沪B2-20XXXXXX"
VITE_EDI_LICENSE=
# Public security network filing number (optional, e.g. "沪公网安备 31010xxxxxxxxx号"). Empty = not shown.
VITE_POLICE_BEIAN=

# API base URL for axios / fetch calls.
# Production: leave as `/api` (same-origin, served by nginx reverse proxy).
# Local dev: vite.config.ts proxies `/api` → http://localhost:8070, so `/api` works there too.
VITE_API_URL=/api

# Sentiment monitoring data source:
#   1 -> uses mocks/sentiment.ts (offline demo, no backend needed)
#   0 or empty -> uses the real /api/sentiment/* (requires backend + sentinel-service running)
VITE_USE_MOCK_SENTIMENT=

# OAuth client IDs (currently unused by the app, kept for future SSO work).
REACT_APP_GOOGLE_CLIENT_ID=
REACT_APP_FACEBOOK_APP_ID=
